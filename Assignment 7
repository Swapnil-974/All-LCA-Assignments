
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import os

# Set visualization style
sns.set_style("whitegrid")


# 1. Load Dataset
def load_dataset(file_path):

    extension = os.path.splitext(file_path)[1].lower()

    if extension == ".csv":
        df = pd.read_csv(file_path)

    elif extension in [".xls", ".xlsx"]:
        df = pd.read_excel(file_path)

    else:
        raise ValueError("Unsupported file format!")

    print("\nDataset Loaded Successfully!")
    print("\nFirst Five Rows:")
    print(df.head())

    print("\nDataset Information:")
    print(df.info())

    print("\nDataset Shape:", df.shape)

    return df


# 2. Line Plot
def line_plot(df):

    numeric_cols = df.select_dtypes(
        include=np.number
    ).columns

    if len(numeric_cols) < 1:
        print("No numerical columns available.")
        return

    plt.figure(figsize=(10, 5))

    for col in numeric_cols[:5]:
        plt.plot(df.index, df[col], label=col)

    plt.title("Line Plot")
    plt.xlabel("Index")
    plt.ylabel("Values")
    plt.legend()
    plt.grid(True)
    plt.tight_layout()
    plt.show()


# 3. Bar Plot
def bar_plot(df):

    categorical_cols = df.select_dtypes(
        include=["object", "category"]
    ).columns

    if len(categorical_cols) > 0:

        col = categorical_cols[0]

        counts = df[col].value_counts().head(10)

        plt.figure(figsize=(9, 5))

        sns.barplot(
            x=counts.index.astype(str),
            y=counts.values,
            hue=counts.index.astype(str),
            palette="viridis",
            legend=False
        )

        plt.title("Bar Plot - " + col)
        plt.xlabel(col)
        plt.ylabel("Count")
        plt.xticks(rotation=45)
        plt.tight_layout()
        plt.show()

    else:

        numeric_cols = df.select_dtypes(
            include=np.number
        ).columns

        if len(numeric_cols) > 0:

            plt.figure(figsize=(9, 5))

            df[numeric_cols[:5]].mean().plot(
                kind="bar",
                color="skyblue"
            )

            plt.title("Bar Plot - Numerical Columns")
            plt.xlabel("Columns")
            plt.ylabel("Mean")
            plt.tight_layout()
            plt.show()


# 4. Scatter Plot
def scatter_plot(df):

    numeric_cols = df.select_dtypes(
        include=np.number
    ).columns

    if len(numeric_cols) < 2:
        print("At least two numerical columns required.")
        return

    plt.figure(figsize=(8, 5))

    sns.scatterplot(
        data=df,
        x=numeric_cols[0],
        y=numeric_cols[1],
        color="red",
        s=70
    )

    plt.title("Scatter Plot")
    plt.xlabel(numeric_cols[0])
    plt.ylabel(numeric_cols[1])
    plt.tight_layout()
    plt.show()


# 5. Heatmap
def heatmap(df):

    numeric_df = df.select_dtypes(
        include=np.number
    )

    if numeric_df.shape[1] < 2:
        print("At least two numerical columns required.")
        return

    correlation = numeric_df.corr()

    plt.figure(figsize=(10, 7))

    sns.heatmap(
        correlation,
        annot=True,
        cmap="coolwarm",
        linewidths=0.5,
        fmt=".2f"
    )

    plt.title("Correlation Heatmap")
    plt.tight_layout()
    plt.show()


# 6. Main Program
if __name__ == "__main__":

    file_path = input(
        "Enter CSV/XLS/XLSX file path: "
    )

    if os.path.exists(file_path):

        df = load_dataset(file_path)

        print("\nGenerating Data Visualizations...")

        line_plot(df)

        bar_plot(df)

        scatter_plot(df)

        heatmap(df)

        print("\nAll Plots Generated Successfully!")

    else:
        print("File Not Found!")

